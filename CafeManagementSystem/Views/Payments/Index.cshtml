@{
    ViewData["Title"] = "Payment Management";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Payment Management</h2>
            <p class="text-muted mb-0">
                Manage payments, monitor transactions, and track payment status.
            </p>
        </div>

        <button class="btn btn-primary" data-bs-toggle="modal"
                data-bs-target="#paymentModal">
            <i class="bi bi-plus-lg me-1"></i> Record Payment
        </button>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total Payments</div>
                    <h3 class="fw-bold mb-0" id="totalPayments">0</h3>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Completed Amount</div>
                    <h3 class="fw-bold text-success mb-0" id="completedAmount">₹0.00</h3>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Pending Payments</div>
                    <h3 class="fw-bold text-warning mb-0" id="pendingPayments">0</h3>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Failed Payments</div>
                    <h3 class="fw-bold text-danger mb-0" id="failedPayments">0</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    <div id="messageBox" class="alert d-none" role="alert"></div>

    <!-- Payment List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 p-3">
            <div class="row g-3 align-items-center">
                <div class="col-lg-5">
                    <h5 class="fw-bold mb-0">Payment Transactions</h5>
                </div>

                <div class="col-sm-7 col-lg-4">
                    <input type="text" id="searchInput" class="form-control"
                           placeholder="Search payment ID, order ID, reference...">
                </div>

                <div class="col-sm-5 col-lg-3">
                    <select id="statusFilter" class="form-select">
                        <option value="">All Payment Statuses</option>
                        <option value="0">Pending</option>
                        <option value="1">Completed</option>
                        <option value="2">Failed</option>
                        <option value="3">Refunded</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Payment ID</th>
                        <th>Order ID</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Transaction Reference</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="paymentsTableBody">
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            Loading payments...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white border-0 text-muted small">
            <span id="resultCount">0 payments</span>
            <button class="btn btn-sm btn-outline-secondary float-end"
                    onclick="loadPayments()">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
        </div>
    </div>
</div>

<!-- Record Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1"
     aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <form id="paymentForm">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title fw-bold" id="paymentModalLabel">
                            Record Payment
                        </h5>
                        <p class="text-muted small mb-0">
                            Record a payment against an order.
                        </p>
                    </div>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label for="paymentOrderId" class="form-label fw-semibold">
                            Order ID <span class="text-danger">*</span>
                        </label>
                        <input type="number" id="paymentOrderId"
                               class="form-control" min="1" required
                               placeholder="Enter completed order ID">
                        <div class="form-text">
                            Enter an existing order ID eligible for payment.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="paymentMethod" class="form-label fw-semibold">
                            Payment Method <span class="text-danger">*</span>
                        </label>
                        <select id="paymentMethod" class="form-select" required>
                            <option value="0">Cash</option>
                            <option value="1">Card</option>
                            <option value="2">UPI</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="transactionReference"
                               class="form-label fw-semibold">
                            Transaction Reference
                        </label>
                        <input type="text" id="transactionReference"
                               class="form-control" maxlength="200"
                               placeholder="Optional transaction reference">
                    </div>

                    <div class="mb-3">
                        <label for="paymentNotes" class="form-label fw-semibold">
                            Notes
                        </label>
                        <textarea id="paymentNotes" class="form-control"
                                  rows="3" maxlength="500"
                                  placeholder="Optional notes"></textarea>
                    </div>

                    <div id="formError" class="alert alert-danger d-none"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-primary"
                            id="savePaymentButton">
                        Record Payment
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- Payment Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1"
     aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="detailsModalLabel">
                    Payment Details
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="paymentDetailsBody">
                Loading...
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
        <script src="~/js/payments.js" asp-append-version="true"></script>
}