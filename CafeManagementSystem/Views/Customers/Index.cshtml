@{
    ViewData["Title"] = "Customer Management";
}
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
<link rel="stylesheet" href="~/css/customers.css" asp-append-version="true" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Customer Management</h2>
        <p class="text-muted mb-0">Manage your cafe customers and their contact information.</p>
    </div>

    <button type="button" class="btn btn-primary" id="addCustomerBtn">
        <i class="bi bi-plus-lg me-1"></i> Add Customer
    </button>

</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-1">Total Customers</p>
                <h3 class="fw-bold mb-0" id="totalCustomers">—</h3>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <label for="customerSearch" class="form-label fw-semibold">
                    Search Customers
                </label>
                <input type="search"
                       id="customerSearch"
                       class="form-control"
                       placeholder="Search by name, email, phone or address..." />
            </div>
        </div>
    </div>

</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0">Customer Directory</h5>

            <button type="button" id="refreshCustomersBtn"
                    class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
        </div>

        <div id="customerError" class="alert alert-danger d-none" role="alert"></div>
        <div id="customerSuccess" class="alert alert-success d-none" role="status"></div>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>Address</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody id="customersTableBody">
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            Loading customers...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="small text-muted" id="customerResultCount"></div>
    </div>

</div>

<!-- Add/Edit Customer Modal -->

<div class="modal fade" id="customerModal" tabindex="-1"
     aria-labelledby="customerModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <form id="customerForm">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="customerModalLabel">
                        Add Customer
                    </h5>

                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="customerId" />

                    <div class="mb-3">
                        <label for="customerName" class="form-label">Customer Name</label>
                        <input type="text" id="customerName" class="form-control"
                               maxlength="150" required />
                    </div>

                    <div class="mb-3">
                        <label for="customerEmail" class="form-label">Email</label>
                        <input type="email" id="customerEmail" class="form-control"
                               maxlength="254" />
                    </div>

                    <div class="mb-3">
                        <label for="customerPhone" class="form-label">Phone Number</label>
                        <input type="tel" id="customerPhone" class="form-control"
                               maxlength="30" />
                    </div>

                    <div class="mb-3">
                        <label for="customerAddress" class="form-label">Address</label>
                        <textarea id="customerAddress" class="form-control"
                                  rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="mb-3" id="customerActiveStatusContainer">
                        <label for="customerIsActive" class="form-label">Customer Status</label>
                        <select id="customerIsActive" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>

                    <div id="customerFormError"
                         class="alert alert-danger d-none mb-0"
                         role="alert"></div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" id="saveCustomerBtn" class="btn btn-primary">
                        Save Customer
                    </button>
                </div>
            </form>

        </div>
    </div>

</div>
@section Scripts{
<script src="~/js/customers.js" asp-append-version="true"></script>
}