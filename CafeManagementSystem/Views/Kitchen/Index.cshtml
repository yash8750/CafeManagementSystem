@{
    ViewData["Title"] = "Kitchen Order Management";
}
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
<link rel="stylesheet" href="~/css/kitchen.css" asp-append-version="true" />
}

<div class="container-fluid py-4 kitchen-page">

    <!-- Page Header -->
    <div class="kitchen-header mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="small mb-2">
                    <i class="bi bi-shop me-1"></i> CAFE OPERATIONS
                </div>

                <h2 class="fw-bold mb-2">
                    <i class="bi bi-fire me-2"></i>Kitchen Display
                </h2>

                <p class="mb-0">
                    Manage incoming orders and track preparation progress.
                </p>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="badge bg-light text-dark px-3 py-2">
                    <i class="bi bi-clock me-1"></i>
                    <span id="lastUpdated">Not refreshed yet</span>
                </span>

                <button type="button" class="btn btn-light"
                        id="refreshButton">
                    <i class="bi bi-arrow-clockwise me-1"></i>
                    Refresh Orders
                </button>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="card kitchen-stat h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">
                        Pending / Confirmed
                    </div>
                    <div class="stat-number" id="waitingCount">0</div>
                    <div class="small text-muted">Awaiting kitchen action</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card kitchen-stat h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">Preparing</div>
                    <div class="stat-number text-warning" id="preparingCount">0</div>
                    <div class="small text-muted">Currently in preparation</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card kitchen-stat h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">Ready</div>
                    <div class="stat-number text-success" id="readyCount">0</div>
                    <div class="small text-muted">Ready to serve or collect</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card kitchen-stat h-100">
                <div class="card-body">
                    <div class="text-muted small mb-2">Active Orders</div>
                    <div class="stat-number text-primary" id="activeCount">0</div>
                    <div class="small text-muted">Orders not yet completed</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Messages -->
    <div id="messageBox" class="alert d-none" role="alert"></div>

    <!-- Orders Toolbar -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div>
                    <h5 class="fw-bold mb-1">Kitchen Orders</h5>
                    <div class="small text-muted" id="orderCount">
                        Loading orders...
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <input type="search" id="searchInput"
                           class="form-control kitchen-filter"
                           placeholder="Search order or item..."
                           aria-label="Search orders">

                    <select id="statusFilter"
                            class="form-select kitchen-filter"
                            aria-label="Filter by order status">
                        <option value="">All statuses</option>
                        <option value="0">Pending</option>
                        <option value="1">Confirmed</option>
                        <option value="2">Preparing</option>
                        <option value="3">Ready</option>
                        <option value="4">Completed</option>
                        <option value="5">Cancelled</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders Grid -->
    <div id="ordersContainer" class="row g-4">
        <div class="col-12">
            <div class="kitchen-empty">
                <div class="spinner-border mb-3" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <div>Loading kitchen orders...</div>
            </div>
        </div>
    </div>

</div>
@section Scripts {
<script src="~/js/kitchen.js" asp-append-version="true"></script>
}