@model CafeManagementSystem.Models.LoginViewModel

@{
ViewData["Title"] = "Admin Login";
Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cafe Management System</title>
    
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />


</head>
<body>
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="brand-icon">☕</div>
            <h2 class="fw-bold mt-2">Cafe Management</h2>
            <p class="text-secondary">Sign in to your admin account</p>
        </div>

    <form id="loginForm">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="email" class="form-label">Email Address</label>
            <input asp-for="Email"
                   id="email"
                   class="form-control"
                   placeholder="Enter your email"
                   autocomplete="username"
                   required />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input asp-for="Password"
                   id="password"
                   class="form-control"
                   placeholder="Enter your password"
                   autocomplete="current-password"
                   required />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div id="loginError"
             class="alert alert-danger d-none"
             role="alert"></div>

        <button type="submit" id="loginButton"
                class="btn btn-cafe w-100 py-2 fw-semibold">
            Sign In
        </button>
    </form>

    <p class="text-center text-secondary small mt-4 mb-0">
        Cafe Management System
    </p>
</div>

  <script src="~/js/login.js" asp-append-version="true"></script>

</body>
</html>